{
  "name": "ourairports-bilingual-api",
  "version": "1.0.0",
  "author": "e404r <https://github.com/e404r>",
  "homepage": "https://github.com/e404r/ourairports-data",
  "repository": {
    "type": "git",
    "url": "https://github.com/e404r/ourairports-data.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,VITE -c cyan,magenta \"npm run dev:api\" \"npm run dev:vite\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:vite": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "csv-parse": "^5.6.0",
    "hono": "^4.7.4",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.13",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vue-tsc": "^2.2.4"
  }
}
